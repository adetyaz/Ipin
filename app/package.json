{
  "name": "@ipin/app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ìpín web app: sender and requester screens (phone-first PWA).",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "prettier --check . && eslint .",
    "fmt": "prettier --write .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/young-serif": "^5.3.0",
    "viem": "^2.57.11",
    "zod": "^4.6.7",
    "@ipin/shared": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "eslint": "^9.39.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
