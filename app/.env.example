# Relayer base URL (docs/api.md section 3). Without it, request and invite
# screens show a "relayer not configured" state.
PUBLIC_RELAYER_URL=http://localhost:8787
# Optional: naira per 1 MUSD, a whole number, for an approximate ₦ line under
# dollar amounts. Leave empty to hide it.
PUBLIC_NGN_PER_USD=
