# Copy to relayer/.env (gitignored). Only RELAYER_PRIVATE_KEY is required.

# Funded Mezo testnet key that pays gas (BTC) and submits execute/executeSchedule.
# Use a throwaway key. Fund it at https://faucet.test.mezo.org
RELAYER_PRIVATE_KEY=

# Mezo testnet RPC (README "Mezo reference").
# RPC_URL=https://rpc.test.mezo.org

# HTTP port and bind address. Render/Railway set PORT themselves.
# PORT=8787
# HOST=0.0.0.0

# Base URL of the app, used in invite links: <APP_URL>/i/<code>.
# APP_URL=http://localhost:5173

# Allowed browser origins: comma-separated, or *. Defaults to APP_URL.
# CORS_ORIGIN=http://localhost:5173

# Where requests/invites (relayer-db.json) and relayer.log are written.
# DATA_DIR=./data
# LOG_DIR=./logs
# LOG_LEVEL=info

# Deployment file. Default: <repo>/deployments/mezo-testnet.json
# DEPLOYMENTS_PATH=

# How often schedules are checked (ms).
# SCHEDULER_INTERVAL_MS=60000
